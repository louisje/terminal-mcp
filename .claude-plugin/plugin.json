{
  "name": "terminal-mcp",
  "version": "0.5.1",
  "description": "A headless terminal emulator exposed via MCP — gives AI assistants a real PTY-backed shell for sudo prompts, SSH/interactive logins, TUI programs, and commands the user wants to watch live.",
  "author": {
    "name": "Louis Jeng",
    "email": "louisje@gmail.com"
  },
  "homepage": "https://github.com/louisje/terminal-mcp",
  "repository": "https://github.com/louisje/terminal-mcp",
  "license": "MIT",
  "keywords": [
    "mcp",
    "terminal",
    "pty",
    "xterm",
    "ai",
    "shell",
    "tui"
  ],
  "mcpServers": {
    "terminal-mcp": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/launch-mcp.sh"
      ]
    }
  },
  "skills": "./skills/"
}
